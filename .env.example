# --- Frontend (inlined into the browser bundle at BUILD time by Vite) ---
# Safe to expose: these are publishable keys.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_AUTH_PROXY=https://example.com/auth/google/callback

# --- Serverless functions (api/*.js), runtime only ---
SUPABASE_URL=https://your-project.supabase.co

# SECRET — never commit this. Set it in Vercel > Settings > Environment Variables.
# It bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Optional: auto-wake a paused Supabase project
FULLSTACK_PROJECT_REF=your-project-ref
FULLSTACK_RESTORE_API_URL=https://example.com/api/fullstack-restore
